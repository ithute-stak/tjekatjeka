# Tjekatjeka product-local infrastructure
TJEKATJEKA_DB_PASSWORD=change-me
TJEKATJEKA_DATABASE_URL=postgresql+psycopg://tjekatjeka:change-me@db:5432/tjekatjeka
TJEKATJEKA_REDIS_URL=redis://redis:6379/0
TJEKATJEKA_DOCUMENT_STORAGE_PATH=/data/documents

# Local ports
TJEKATJEKA_FRONTEND_PORT=3204
TJEKATJEKA_BACKEND_PORT=8204

# Product identity
TJEKATJEKA_PUBLIC_URL=http://localhost:3204
TJEKATJEKA_BACKEND_INTERNAL_URL=http://backend:8204
TJEKATJEKA_AUTH_ISSUER=https://auth.ithute.co.ls
TJEKATJEKA_AUTH_AUDIENCE=tjekatjeka
TJEKATJEKA_AUTH_CLIENT_ID=tjekatjeka
TJEKATJEKA_OIDC_REDIRECT_URI=http://localhost:3204/api/auth/oidc/callback
TJEKATJEKA_COOKIE_SECURE=false
TJEKATJEKA_BOOTSTRAP_ADMIN_EMAIL=

# Local-only convenience. MUST be false in production.
TJEKATJEKA_DEV_AUTH_BYPASS=true
